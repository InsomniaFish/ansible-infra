apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ metrics_server_name }}
  namespace: {{ metrics_server_namespace }}
  labels:
    k8s-app: {{ metrics_server_name }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: system:{{ metrics_server_name }}
  labels:
    k8s-app: {{ metrics_server_name }}
    rbac.authorization.k8s.io/aggregate-to-admin: "true"
    rbac.authorization.k8s.io/aggregate-to-edit: "true"
    rbac.authorization.k8s.io/aggregate-to-view: "true"
rules:
  - apiGroups: [""]
    resources:
      - nodes/metrics
    verbs: ["get"]
  - apiGroups: [""]
    resources:
      - pods
      - nodes
      - namespaces
      - configmaps
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: extension-apiserver-authentication-reader
  namespace: kube-system
  labels:
    k8s-app: {{ metrics_server_name }}
rules:
  - apiGroups: [""]
    resources:
      - configmaps
    verbs: ["get"]
  - apiGroups: [""]
    resourceNames:
      - extension-apiserver-authentication
    resources:
      - configmaps
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ metrics_server_name }}:system:auth-delegator
  labels:
    k8s-app: {{ metrics_server_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:auth-delegator
subjects:
  - kind: ServiceAccount
    name: {{ metrics_server_name }}
    namespace: {{ metrics_server_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ metrics_server_name }}-auth-reader
  namespace: kube-system
  labels:
    k8s-app: {{ metrics_server_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: extension-apiserver-authentication-reader
subjects:
  - kind: ServiceAccount
    name: {{ metrics_server_name }}
    namespace: {{ metrics_server_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: system:{{ metrics_server_name }}
  labels:
    k8s-app: {{ metrics_server_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:{{ metrics_server_name }}
subjects:
  - kind: ServiceAccount
    name: {{ metrics_server_name }}
    namespace: {{ metrics_server_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ metrics_server_name }}
  namespace: {{ metrics_server_namespace }}
  labels:
    k8s-app: {{ metrics_server_name }}
spec:
  replicas: {{ metrics_server_replicas }}
  strategy:
    rollingUpdate:
      maxUnavailable: 0
  selector:
    matchLabels:
      k8s-app: {{ metrics_server_name }}
  template:
    metadata:
      labels:
        k8s-app: {{ metrics_server_name }}
    spec:
      serviceAccountName: {{ metrics_server_name }}
      priorityClassName: system-cluster-critical
{% if metrics_server_host_network | bool %}
      hostNetwork: true
{% endif %}
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: {{ metrics_server_name }}
          image: {{ metrics_server_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --cert-dir=/tmp
            - --secure-port=10250
            - --kubelet-preferred-address-types={{ metrics_server_kubelet_preferred_address_types }}
            - --kubelet-use-node-status-port
            - --metric-resolution={{ metrics_server_metric_resolution }}
{% if metrics_server_kubelet_insecure_tls | bool %}
            - --kubelet-insecure-tls
{% endif %}
          ports:
            - name: https
              containerPort: 10250
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /readyz
              port: https
              scheme: HTTPS
            initialDelaySeconds: 20
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /livez
              port: https
              scheme: HTTPS
            initialDelaySeconds: 60
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: {{ metrics_server_resources_requests_cpu }}
              memory: {{ metrics_server_resources_requests_memory }}
            limits:
              cpu: {{ metrics_server_resources_limits_cpu }}
              memory: {{ metrics_server_resources_limits_memory }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 10001
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp-dir
              mountPath: /tmp
      nodeSelector:
        kubernetes.io/os: linux
      volumes:
        - name: tmp-dir
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ metrics_server_name }}
  namespace: {{ metrics_server_namespace }}
  labels:
    k8s-app: {{ metrics_server_name }}
    kubernetes.io/name: "Metrics-server"
spec:
  selector:
    k8s-app: {{ metrics_server_name }}
  ports:
    - name: https
      port: 443
      protocol: TCP
      targetPort: 10250
---
apiVersion: apiregistration.k8s.io/v1
kind: APIService
metadata:
  name: v1beta1.metrics.k8s.io
  labels:
    k8s-app: {{ metrics_server_name }}
spec:
  service:
    name: {{ metrics_server_name }}
    namespace: {{ metrics_server_namespace }}
  group: metrics.k8s.io
  version: v1beta1
  insecureSkipTLSVerify: true
  groupPriorityMinimum: 100
  versionPriority: 100
