# cp inventory/inventory.ini.example inventory/inventory.ini

[gpu_nodes]
# master01 ansible_host=192.168.48.100 ansible_connection=local
# node01   ansible_host=192.168.48.101
# node02   ansible_host=192.168.48.102 ansible_user=root ansible_password=该主机密码

[gpu_nodes:vars]
ansible_user=root
# ansible_password=你的密码
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[k8s_master]
# master01 ansible_host=192.168.48.100 ansible_user=root ansible_connection=local

[k8s_nodes]
# node01 ansible_host=192.168.48.101 ansible_user=root ansible_password=该主机密码
# node02 ansible_host=192.168.48.102 ansible_user=root ansible_password=该主机密码

[nfs_server]
# master01

[nfs_clients]
# master01
# node01
# node02

[k8s_cluster:children]
k8s_master
k8s_nodes

[linux:children]
k8s_cluster

[linux:vars]
# ansible_user=root
# ansible_password=你的密码
# ansible_become=true
# ansible_become_method=sudo
# ansible_become_password=sudo密码
